{
  "name": "explainer-editing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Automated render stage for narrated explainer videos: tighten VO, plan beats, render with Remotion.",
  "bin": {"explainer": "cli/explainer.mjs"},
